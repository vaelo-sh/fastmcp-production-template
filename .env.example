# Copy to .env and fill in. Never commit .env.
MCP_ENV=dev                 # dev | prod (prod refuses MCP_AUTH=none over HTTP)
MCP_TRANSPORT=stdio         # stdio | http
MCP_HOST=127.0.0.1
MCP_PORT=8000               # Cloud Run sets PORT; it wins if present
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=          # comma list, e.g. mcp.example.com (enables Host/Origin protection)
MCP_LOG_LEVEL=INFO
MCP_LOG_FORMAT=json         # json | text
MCP_RATE_LIMIT_RPS=10

# --- Auth: one switch ---
MCP_AUTH=none               # none | static | jwt
MCP_DEV_TOKEN=              # MCP_AUTH=static: a long random string (dev/internal only)
MCP_JWT_JWKS_URI=           # MCP_AUTH=jwt: e.g. https://<project>.supabase.co/auth/v1/.well-known/jwks.json
MCP_JWT_PUBLIC_KEY=         # MCP_AUTH=jwt: PEM, instead of JWKS
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
MCP_JWT_ALGORITHM=          # e.g. RS256 or ES256
MCP_REQUIRED_SCOPES=        # comma list required on every request
MCP_WRITE_SCOPE=notes:write # scope required by create_note when auth is on
MCP_AUTH_SERVERS=           # comma list of authorization server URLs -> publishes Protected Resource Metadata
MCP_BASE_URL=               # public URL of this server, needed with MCP_AUTH_SERVERS

# --- Telemetry (optional; install the `otel` extra) ---
OTEL_SERVICE_NAME=mcp-to-prod
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://localhost:4317
MCP_OTEL_CONSOLE=0             # 1 = print spans to stderr (local debugging)
